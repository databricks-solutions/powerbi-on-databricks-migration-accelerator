model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["orders","lineitem","part","customer","region","nation"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table MeasuresTable
ref table orders
ref table lineitem
ref table part
ref table customer
ref table region
ref table nation

ref cultureInfo en-US

