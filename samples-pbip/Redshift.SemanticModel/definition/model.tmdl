model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["region","nation","customer","part","orders","lineitem"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table MeasuresTable
ref table region
ref table nation
ref table customer
ref table part
ref table orders
ref table lineitem

ref cultureInfo en-US

